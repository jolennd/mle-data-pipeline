# Single value every file reads. File database, one writer at a time.
DB_CONN=duckdb:///data/warehouse.duckdb
# Download step. Links are built from these, never hard-coded.
SOURCE_BASE_URL=https://d37ci6vzurychx.cloudfront.net/trip-data
SOURCE_FILE_PATTERN=green_tripdata_{partition}.parquet
PARTITIONS=2025-01,2025-02,2025-03
STAGING_DIR=data/raw
